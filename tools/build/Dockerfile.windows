# Docker image for cross-compiling labelize for Windows (x86_64-pc-windows-gnu)
FROM rust:1.97.1-bookworm

# Install the Windows cross-compiler and build tools
RUN apt-get update && apt-get install -y \
    mingw-w64 \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Add the Windows target
RUN rustup target add x86_64-pc-windows-gnu

# Cargo configuration for the Windows linker
RUN printf '[target.x86_64-pc-windows-gnu]\nlinker = "x86_64-w64-mingw32-gcc"\n' > /usr/local/cargo/config.toml

WORKDIR /app

# Dependency cache layer: stub sources (lib + bin) compile the dependency tree
# once so later source changes reuse the cached artifacts
COPY Cargo.toml Cargo.lock ./
RUN mkdir -p src && echo 'fn main() {}' > src/main.rs && touch src/lib.rs
RUN cargo build --release --locked --target x86_64-pc-windows-gnu --features cli || true

# Copy the sources and build. Docker COPY preserves the sources' original
# (older) mtimes while the stub artifacts are newer, so cargo would consider
# the crate fresh and silently ship the stub binary — clean the package
# artifacts to force the rebuild; the dependency cache stays intact.
COPY . .
RUN cargo clean --package labelize --release --target x86_64-pc-windows-gnu
RUN cargo build --release --locked --target x86_64-pc-windows-gnu --features cli

# Collect the output
RUN mkdir -p /output && \
    cp /app/target/x86_64-pc-windows-gnu/release/labelize.exe /output/labelize.exe
