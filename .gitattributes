# Reverse golden snapshots are compared byte-for-byte on every platform.
/testdata/reverse/*.zpl text eol=lf
/testdata/reverse/*.tspl binary

# Counted graphic payloads include literal command prefixes and CR/LF/TAB bytes.
/testdata/unit/zpl_binary_graphics.zpl binary
/testdata/invalid/usps_apo_truncated.zpl binary

# This DPL fixture uses literal CR record separators and a final CRLF.
/testdata/unit/dpl_2d_graphics.dpl -text whitespace=cr-at-eol

# DPL file contains a binary BMP download.
/testdata/dpl/downloaded_image.dpl binary

# Studio directories address bytes; Java's native jobs are compared byte-for-byte.
/testdata/templates/printers/* -text whitespace=cr-at-eol

# The same notice is embedded in the OpenType name table and shipped as text.
/licenses/Unifont-OFL.txt text eol=lf
